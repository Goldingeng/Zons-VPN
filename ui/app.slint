import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { State, Node, Group, Profile, Conn } from "types.slint";
import { NavItem, Icon } from "parts.slint";
import { HomePage } from "home.slint";
import { ProxiesPage } from "proxies.slint";
import { ProfilesPage } from "profiles.slint";
import { BypassPage } from "bypass.slint";
import { ConnsPage } from "conns.slint";
import { SettingsPage } from "settings.slint";

export { State, Node, Group, Profile, Conn }

export component AppWindow inherits Window {
    title: "Zons VPN";
    preferred-width: 1040px;
    preferred-height: 700px;
    min-width: 820px;
    min-height: 560px;
    background: Theme.bg;
    default-font-family: "Segoe UI";
    HorizontalLayout {
        Rectangle {
            width: 220px;
            background: Theme.side;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.line;
            }
            VerticalLayout {
                padding: 16px;
                padding-top: 24px;
                spacing: 4px;
                HorizontalLayout {
                    padding-left: 8px;
                    spacing: 10px;
                    height: 32px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            d: Icons.shield;
                            width: 24px;
                            height: 24px;
                            color: Theme.accent-text;
                        }
                    }
                    Text {
                        text: "Zons VPN";
                        color: Theme.text;
                        font-size: 19px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 22px;
                }
                for item[i] in [
                    { t: "Обзор", d: Icons.grid },
                    { t: "Прокси", d: Icons.nodes },
                    { t: "Профили", d: Icons.file },
                    { t: "Мимо VPN", d: Icons.bypass },
                    { t: "Подключения", d: Icons.pulse },
                    { t: "Настройки", d: Icons.gear },
                ]: NavItem {
                    text: item.t;
                    icon: item.d;
                    active: State.page == i;
                    clicked => {
                        State.page = i;
                        State.page-changed(i);
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    padding-left: 8px;
                    spacing: 8px;
                    VerticalLayout {
                        padding-top: 6px;
                        Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 4px;
                            background: State.ready ? Theme.good : State.running ? Theme.warn : Theme.faint;
                        }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: State.ready ? "Ядро работает" : State.running ? "Запуск ядра…" : "Ядро остановлено";
                            color: Theme.text;
                            font-size: 12px;
                        }
                        Text {
                            text: "mihomo";
                            color: Theme.faint;
                            font-size: 11px;
                        }
                    }
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            if State.page == 0: HomePage {
                width: parent.width;
                height: parent.height;
            }
            if State.page == 1: ProxiesPage {
                width: parent.width;
                height: parent.height;
            }
            if State.page == 2: ProfilesPage {
                width: parent.width;
                height: parent.height;
            }
            if State.page == 3: BypassPage {
                width: parent.width;
                height: parent.height;
            }
            if State.page == 4: ConnsPage {
                width: parent.width;
                height: parent.height;
            }
            if State.page == 5: SettingsPage {
                width: parent.width;
                height: parent.height;
            }
        }
    }
}
