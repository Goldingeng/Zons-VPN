import { Theme } from "theme.slint";
import { State, Node, Group, Profile, Conn } from "types.slint";
import { NavItem } from "parts.slint";
import { HomePage } from "home.slint";
import { ProxiesPage } from "proxies.slint";
import { ProfilesPage } from "profiles.slint";
import { BypassPage } from "bypass.slint";
import { ConnsPage } from "conns.slint";
import { SettingsPage } from "settings.slint";

export { State, Node, Group, Profile, Conn }

export component AppWindow inherits Window {
    title: "Clash";
    icon: @image-url("../assets/window.png");
    preferred-width: 1040px;
    preferred-height: 700px;
    min-width: 780px;
    min-height: 540px;
    background: Theme.bg;
    default-font-family: "Segoe UI";
    HorizontalLayout {
        Rectangle {
            width: 210px;
            background: Theme.side;
            VerticalLayout {
                padding: 14px;
                spacing: 6px;
                Text {
                    text: "Clash";
                    color: Theme.text;
                    font-size: 24px;
                    font-weight: 700;
                }
                Rectangle {
                    height: 14px;
                }
                for item[i] in ["Обзор", "Прокси", "Профили", "Мимо VPN", "Подключения", "Настройки"]: NavItem {
                    text: item;
                    active: State.page == i;
                    clicked => {
                        State.page = i;
                        State.page-changed(i);
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                }
                Text {
                    text: State.ready ? "● mihomo работает" : State.running ? "● запуск…" : "● ядро остановлено";
                    color: State.ready ? Theme.good : State.running ? Theme.warn : Theme.dim;
                    font-size: 12px;
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            if State.page == 0: HomePage {
                width: parent.width;
                height: parent.height;
            }
            if State.page == 1: ProxiesPage {
                width: parent.width;
                height: parent.height;
            }
            if State.page == 2: ProfilesPage {
                width: parent.width;
                height: parent.height;
            }
            if State.page == 3: BypassPage {
                width: parent.width;
                height: parent.height;
            }
            if State.page == 4: ConnsPage {
                width: parent.width;
                height: parent.height;
            }
            if State.page == 5: SettingsPage {
                width: parent.width;
                height: parent.height;
            }
        }
    }
}
