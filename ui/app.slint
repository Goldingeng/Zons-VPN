import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { State, Node, Group, Profile, Conn, Pick } from "types.slint";
import { NavItem, Icon, Show } from "parts.slint";
import { HomePage } from "home.slint";
import { ProxiesPage } from "proxies.slint";
import { ProfilesPage } from "profiles.slint";
import { BypassPage, PickPanel } from "bypass.slint";
import { ConnsPage } from "conns.slint";
import { SettingsPage } from "settings.slint";

export { State, Node, Group, Profile, Conn, Pick }

export component AppWindow inherits Window {
    title: "Zons VPN";
    icon: @image-url("../assets/window.png");
    preferred-width: 1040px;
    preferred-height: 700px;
    min-width: 820px;
    min-height: 560px;
    background: Theme.bg;
    default-font-family: "Segoe UI";
    in-out property <bool> flip;
    property <bool> compact: State.side < 150px;
    HorizontalLayout {
        Rectangle {
            width: State.side;
            background: Theme.side;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.line;
            }
            Rectangle {
                x: root.compact ? 10px : 16px;
                y: 86px + State.page * 40px;
                width: parent.width - 2 * self.x;
                height: 36px;
                border-radius: 8px;
                background: Theme.accent-soft;
                animate y { duration: 260ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                Rectangle {
                    x: 0px;
                    y: 10px;
                    width: 3px;
                    height: 16px;
                    border-radius: 2px;
                    background: Theme.accent-text;
                }
            }
            VerticalLayout {
                padding: root.compact ? 10px : 16px;
                padding-top: 24px;
                spacing: 4px;
                HorizontalLayout {
                    padding-left: root.compact ? (State.side - 44px) / 2 : 8px;
                    spacing: 10px;
                    height: 32px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            d: Icons.shield;
                            width: 24px;
                            height: 24px;
                            color: Theme.accent-text;
                        }
                    }
                    if !root.compact: Text {
                        text: "Zons VPN";
                        color: Theme.text;
                        font-size: 19px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 22px;
                }
                for item[i] in [
                    { t: "Обзор", d: Icons.grid },
                    { t: "Прокси", d: Icons.nodes },
                    { t: "Профили", d: Icons.file },
                    { t: "Мимо VPN", d: Icons.bypass },
                    { t: "Подключения", d: Icons.pulse },
                    { t: "Настройки", d: Icons.gear },
                ]: NavItem {
                    text: item.t;
                    icon: item.d;
                    active: State.page == i;
                    compact: root.compact;
                    clicked => {
                        State.page = i;
                        State.page-changed(i);
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                }
                Rectangle {
                    height: 54px;
                    border-radius: 8px;
                    background: State.active ? Theme.good-fill : Theme.card;
                    animate background { duration: 400ms; easing: ease-in-out; }
                    HorizontalLayout {
                        padding-left: root.compact ? (State.side - 20px - 10px) / 2 : 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: State.active ? #ffffff : Theme.faint;
                                animate background { duration: 400ms; }
                            }
                        }
                        if !root.compact: VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: State.active ? "VPN включён" : "VPN выключен";
                                color: State.active ? #ffffff : Theme.text;
                                animate color { duration: 400ms; }
                                font-size: 14px;
                                font-weight: 600;
                            }
                            Text {
                                text: State.ready ? "Ядро работает" : State.running ? "Запуск ядра…" : "Ядро остановлено";
                                color: State.active ? #d5f3e3 : Theme.faint;
                                animate color { duration: 400ms; }
                                font-size: 11px;
                            }
                        }
                    }
                }
            }
        }
        Rectangle {
            width: 0px;
            drag := TouchArea {
                x: -3px;
                width: 7px;
                mouse-cursor: col-resize;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.up {
                        State.side-changed(State.side);
                    }
                }
                moved => {
                    State.side = max(64px, min(320px, State.side + self.mouse-x - 3.5px));
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            if State.page == 0: Show {
                width: parent.width;
                height: parent.height;
                HomePage {
                    width: parent.width;
                    height: parent.height;
                }
            }
            if State.page == 1: Show {
                width: parent.width;
                height: parent.height;
                ProxiesPage {
                    width: parent.width;
                    height: parent.height;
                }
            }
            if State.page == 2: Show {
                width: parent.width;
                height: parent.height;
                ProfilesPage {
                    width: parent.width;
                    height: parent.height;
                }
            }
            if State.page == 3: Show {
                width: parent.width;
                height: parent.height;
                BypassPage {
                    width: parent.width;
                    height: parent.height;
                }
            }
            if State.page == 4: Show {
                width: parent.width;
                height: parent.height;
                ConnsPage {
                    width: parent.width;
                    height: parent.height;
                }
            }
            if State.page == 5: Show {
                width: parent.width;
                height: parent.height;
                SettingsPage {
                    width: parent.width;
                    height: parent.height;
                }
            }
            if State.page == 3 && State.pick-kind > 0: PickPanel {
                width: parent.width;
                height: parent.height;
            }
        }
    }
    Rectangle {
        background: root.flip ? #00000001 : #00000000;
    }
}
