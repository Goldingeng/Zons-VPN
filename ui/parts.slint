import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";

export component Icon inherits Path {
    in property <string> d;
    in property <color> color: Theme.dim;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.d;
    stroke: root.color;
    stroke-width: 1.6px;
    fill: transparent;
}

export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.line;
}

export component Title inherits Text {
    color: Theme.text;
    font-size: 26px;
    font-weight: 600;
}

export component Head inherits Text {
    color: Theme.text;
    font-size: 14px;
    font-weight: 600;
}

export component Label inherits Text {
    color: Theme.text;
    font-size: 14px;
    vertical-alignment: center;
}

export component Dim inherits Text {
    color: Theme.dim;
    font-size: 12px;
}

export component Btn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    horizontal-stretch: 0;
    border-radius: 8px;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.line;
    opacity: root.enabled ? 1 : 0.5;
    background: root.primary ? (ta.pressed ? Theme.accent : ta.has-hover ? Theme.accent-hover : Theme.accent) : (ta.pressed ? Theme.line : ta.has-hover ? Theme.hover : Theme.raised);
    animate background { duration: Theme.fast; easing: ease-out; }
    animate opacity { duration: Theme.mid; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                d: root.icon;
                width: 15px;
                height: 15px;
                color: root.primary ? #ffffff : Theme.dim;
            }
        }
        Text {
            text: root.text;
            color: root.primary ? #ffffff : Theme.text;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component Toggle inherits Rectangle {
    in property <bool> on;
    callback toggled(bool);
    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Theme.accent : tt.has-hover ? Theme.off-hover : Theme.line;
    animate background { duration: Theme.mid; easing: ease-in-out; }
    Rectangle {
        x: root.on ? parent.width - self.width - 3px : 3px;
        width: tt.pressed ? 19px : 16px;
        height: 16px;
        border-radius: 8px;
        background: root.on ? #ffffff : #c9ced6;
        animate x, width { duration: Theme.mid; easing: ease-out; }
        animate background { duration: Theme.mid; }
    }
    tt := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggled(!root.on);
        }
    }
}

export component Seg inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 34px;
    horizontal-stretch: 1;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.active ? Theme.accent-line : Theme.card;
    background: root.active ? Theme.accent-soft : ta.has-hover ? Theme.hover : Theme.card;
    animate background, border-color { duration: Theme.mid; easing: ease-out; }
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.active ? Theme.text : Theme.dim;
        animate color { duration: Theme.mid; }
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    in property <bool> compact;
    callback clicked;
    height: 36px;
    border-radius: 8px;
    background: !root.active && ta.has-hover ? Theme.hover : Theme.hover.transparentize(1);
    animate background { duration: Theme.fast; }
    HorizontalLayout {
        padding-left: root.compact ? (root.width - 20px) / 2 : 14px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                d: root.icon;
                color: root.active ? Theme.accent-text : ta.has-hover ? Theme.text : Theme.dim;
                animate color { duration: Theme.mid; }
            }
        }
        if !root.compact: Text {
            text: root.text;
            color: root.active || ta.has-hover ? Theme.text : Theme.dim;
            animate color { duration: Theme.mid; }
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component Scroll inherits ScrollView {
    in property <length> gap: 8px;
    in property <length> pad: 0px;
    viewport-width: self.visible-width;
    viewport-height: lay.preferred-height;
    lay := VerticalLayout {
        width: root.visible-width;
        padding-bottom: root.pad;
        spacing: root.gap;
        @children
    }
}

export component Header inherits HorizontalLayout {
    in property <string> title;
    spacing: 10px;
    height: 40px;
    Title {
        text: root.title;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    @children
}

export component Empty inherits VerticalLayout {
    in property <string> icon;
    in property <string> title;
    alignment: center;
    spacing: 8px;
    padding: 16px;
    HorizontalLayout {
        alignment: center;
        Icon {
            d: root.icon;
            width: 22px;
            height: 22px;
        }
    }
    Text {
        text: root.title;
        color: Theme.text;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

export component AppRow inherits Rectangle {
    in property <string> name;
    in property <string> hint;
    in property <string> action;
    in property <image> icon;
    in property <bool> slot;
    callback clicked;
    height: 40px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.hover : Theme.hover.transparentize(1);
    opacity: 0;
    animate background { duration: Theme.fast; }
    animate opacity { duration: Theme.mid; easing: ease-out; }
    init => {
        self.opacity = 1;
    }
    ta := TouchArea { }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 8px;
        if root.slot: VerticalLayout {
            alignment: center;
            Image {
                width: 20px;
                height: 20px;
                source: root.icon;
            }
        }
        Label {
            text: root.name;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.hint != "": VerticalLayout {
            alignment: center;
            Dim {
                text: root.hint;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                text: root.action;
                height: 28px;
                clicked => {
                    root.clicked();
                }
            }
        }
    }
}

export component Column inherits HorizontalLayout {
    in property <length> max: 760px;
    Rectangle {
        horizontal-stretch: 1;
    }
    VerticalLayout {
        max-width: root.max;
        horizontal-stretch: 1000;
        spacing: 16px;
        @children
    }
    Rectangle {
        horizontal-stretch: 1;
    }
}

export component Show inherits Rectangle {
    property <float> t;
    opacity: root.t;
    y: (1 - root.t) * 14px;
    animate t { duration: 260ms; easing: ease-out; }
    init => {
        root.t = 1;
    }
    @children
}
