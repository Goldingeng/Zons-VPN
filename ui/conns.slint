import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { State, Conn } from "types.slint";
import { Card, Header, Dim, Btn, Scroll, Empty, Icon } from "parts.slint";

component ConnRow inherits Rectangle {
    in property <Conn> c;
    height: 50px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.hover : Theme.card;
    opacity: 0;
    animate background { duration: Theme.fast; }
    animate opacity { duration: Theme.mid; easing: ease-out; }
    init => {
        self.opacity = 1;
    }
    ta := TouchArea { }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 2;
            Text {
                text: root.c.process;
                color: Theme.text;
                font-size: 13px;
                overflow: elide;
            }
            Dim {
                text: root.c.rule;
                color: Theme.faint;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 3;
            Text {
                text: root.c.host;
                color: Theme.text;
                font-size: 13px;
                overflow: elide;
            }
            Dim {
                text: root.c.chain;
                overflow: elide;
            }
        }
        Text {
            width: 80px;
            text: root.c.down;
            color: Theme.dim;
            font-size: 12px;
            vertical-alignment: center;
        }
        Text {
            width: 80px;
            text: root.c.up;
            color: Theme.dim;
            font-size: 12px;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 6px;
                background: x.has-hover ? Theme.line : Theme.line.transparentize(1);
                animate background { duration: Theme.fast; }
                Icon {
                    d: Icons.close;
                    width: 14px;
                    height: 14px;
                    color: x.has-hover ? Theme.bad : Theme.faint;
                    animate color { duration: Theme.fast; }
                }
                x := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        State.close-conn(root.c.id);
                    }
                }
            }
        }
    }
}

export component ConnsPage inherits VerticalLayout {
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 26px;
    padding-bottom: 24px;
    spacing: 16px;
    Header {
        title: "Подключения";
        Dim {
            text: State.conns.length;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-stretch: 100;
        }
        VerticalLayout {
            alignment: center;
            Btn {
                text: "Закрыть все";
                enabled: State.conns.length > 0;
                clicked => {
                    State.close-all();
                }
            }
        }
    }
    Card {
        vertical-stretch: 1;
        VerticalLayout {
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 14px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 12px;
                Dim {
                    text: "Приложение";
                    horizontal-stretch: 2;
                }
                Dim {
                    text: "Назначение";
                    horizontal-stretch: 3;
                }
                Dim {
                    width: 80px;
                    text: "Загрузка";
                }
                Dim {
                    width: 80px;
                    text: "Отдача";
                }
                Rectangle {
                    width: 26px;
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            if State.conns.length == 0: Empty {
                vertical-stretch: 1;
                icon: Icons.pulse;
                title: State.running ? "Активных подключений нет" : "Ядро не запущено";
            }
            if State.conns.length > 0: Scroll {
                vertical-stretch: 1;
                gap: 0px;
                pad: 6px;
                for c in State.conns: ConnRow {
                    c: c;
                }
            }
        }
    }
}
