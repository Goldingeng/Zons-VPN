import { Theme } from "theme.slint";
import { State, Conn } from "types.slint";
import { Title, Dim, Btn, Scroll } from "parts.slint";

component ConnRow inherits Rectangle {
    in property <Conn> c;
    height: 56px;
    border-radius: 10px;
    background: Theme.card;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 3;
            Text {
                text: root.c.host;
                color: Theme.text;
                font-size: 13px;
                overflow: elide;
            }
            Dim {
                text: root.c.process + " · " + root.c.rule;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 2;
            Dim {
                text: root.c.chain;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Dim {
                text: "↓ " + root.c.down + "   ↑ " + root.c.up;
            }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                text: "×";
                clicked => {
                    State.close-conn(root.c.id);
                }
            }
        }
    }
}

export component ConnsPage inherits VerticalLayout {
    padding: 24px;
    spacing: 16px;
    HorizontalLayout {
        spacing: 8px;
        Title {
            text: "Подключения: " + State.conns.length;
            horizontal-stretch: 1;
        }
        Btn {
            text: "Закрыть все";
            clicked => {
                State.close-all();
            }
        }
    }
    if State.conns.length == 0: Dim {
        text: State.running ? "Активных подключений нет" : "Ядро не запущено";
    }
    Scroll {
        vertical-stretch: 1;
        gap: 6px;
        for c in State.conns: ConnRow {
            c: c;
        }
    }
}
