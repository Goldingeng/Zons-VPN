import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { ScrollView } from "std-widgets.slint";
import { State, Node, Group } from "types.slint";
import { Card, Header, Label, Dim, Seg, Icon, Toggle, Scroll, Column, Btn } from "parts.slint";

component Stat inherits HorizontalLayout {
    in property <string> icon;
    in property <string> label;
    in property <string> value;
    in property <string> sub;
    horizontal-stretch: 1;
    spacing: 12px;
    VerticalLayout {
        alignment: center;
        Icon {
            d: root.icon;
        }
    }
    VerticalLayout {
        spacing: 2px;
        Dim {
            text: root.label;
        }
        Text {
            text: root.value;
            color: Theme.text;
            font-size: 20px;
            font-weight: 600;
        }
        Dim {
            text: root.sub;
            color: Theme.faint;
        }
    }
}

component Step inherits HorizontalLayout {
    in property <string> icon;
    in property <string> label;
    in property <string> value;
    in property <string> extra;
    spacing: 10px;
    horizontal-stretch: 1;
    VerticalLayout {
        alignment: center;
        Icon {
            d: root.icon;
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        Dim {
            text: root.label;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.value;
                color: Theme.text;
                font-size: 14px;
                overflow: elide;
            }
            Text {
                text: root.extra;
                color: Theme.accent-text;
                font-size: 14px;
            }
        }
    }
}

component Link inherits Rectangle {
    width: 40px;
    Rectangle {
        x: 4px;
        width: 26px;
        height: 1px;
        background: Theme.line;
    }
    Rectangle {
        x: 30px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        border-width: 1px;
        border-color: Theme.faint;
    }
}

component Wave inherits Rectangle {
    in property <color> tint;
    in property <bool> solid;
    property <float> t;
    width: 128px + root.t * (root.solid ? 150px : 96px);
    height: self.width;
    border-radius: self.width / 2;
    border-width: root.solid ? 0px : 2px;
    border-color: root.tint;
    background: root.solid ? root.tint.transparentize(0.3 + root.t * 0.7) : transparent;
    opacity: 1 - root.t;
    animate t { duration: root.solid ? 1200ms : 900ms; easing: cubic-bezier(0.1, 0.7, 0.3, 1); }
    init => {
        root.t = 1;
    }
}

component Power inherits Rectangle {
    property <bool> connecting: State.running && !State.ready;
    property <bool> on: State.active;
    property <int> waves;
    property <color> tint: Theme.accent-text;
    property <bool> burst;
    property <bool> dim;
    width: 148px;
    height: 148px;
    changed on => {
        if root.on {
            root.tint = Theme.good;
            root.burst = true;
            root.waves += 1;
        }
    }
    Timer {
        running: root.connecting;
        interval: 900ms;
        triggered => {
            root.tint = Theme.warn;
            root.burst = false;
            root.waves += 1;
            root.dim = !root.dim;
        }
    }
    if root.waves > 0 && Math.mod(root.waves, 2) == 1: Wave {
        tint: root.tint;
        solid: root.burst;
    }
    if root.waves > 0 && Math.mod(root.waves, 2) == 0: Wave {
        tint: root.tint;
        solid: root.burst;
    }
    Rectangle {
        width: ta.pressed ? 140px : ta.has-hover ? 152px : 148px;
        height: self.width;
        border-radius: self.width / 2;
        border-width: 3px;
        border-color: root.connecting ? (root.dim ? Theme.warn.transparentize(0.6) : Theme.warn) : State.active ? Theme.good : ta.has-hover ? Theme.off-hover : Theme.off;
        animate width { duration: 180ms; easing: ease-out; }
        animate border-color { duration: 700ms; easing: ease-in-out; }
    }
    Rectangle {
        width: ta.pressed ? 118px : 128px;
        height: self.width;
        border-radius: self.width / 2;
        background: State.tun ? (ta.has-hover ? Theme.good-hover : Theme.good-fill) : (ta.has-hover ? Theme.off-hover : Theme.off);
        animate width { duration: 180ms; easing: ease-out; }
        animate background { duration: 450ms; easing: ease-in-out; }
        Icon {
            d: Icons.power;
            width: ta.pressed ? 40px : 44px;
            height: self.width;
            stroke-width: 2.2px;
            color: State.tun ? #ffffff : ta.has-hover ? Theme.text : Theme.dim;
            animate width { duration: 180ms; easing: ease-out; }
            animate color { duration: 450ms; easing: ease-in-out; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.tint = State.tun ? Theme.faint : Theme.accent-text;
            root.burst = false;
            root.waves += 1;
            State.set-tun(!State.tun);
        }
    }
}

component DropRow inherits Rectangle {
    in property <string> name;
    in property <bool> selected;
    in property <string> tail;
    in property <color> tail-color: Theme.faint;
    callback clicked;
    height: 36px;
    border-radius: 6px;
    background: root.selected ? Theme.accent-soft : ta.has-hover ? Theme.hover : Theme.raised;
    animate background { duration: Theme.fast; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                d: root.selected ? Icons.check : Icons.globe;
                width: 14px;
                height: 14px;
                color: root.selected ? Theme.accent-text : Theme.faint;
            }
        }
        Text {
            text: root.name;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.tail != "": Text {
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: right;
            text: root.tail;
            color: root.tail-color;
        }
    }
}

component Drop inherits Rectangle {
    in property <int> kind;
    in property <Group> group;
    callback picked;
    width: 300px;
    height: root.kind == 1 ? min(State.profiles.length * 38px, 228px) + 16px : (root.group.nodes.length > 0 ? 44px + min(root.group.nodes.length * 38px, 228px) + 8px : 44px);
    background: Theme.raised;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.line;
    opacity: 0;
    animate opacity { duration: 180ms; easing: ease-out; }
    init => {
        self.opacity = 1;
    }
    TouchArea { }
    if root.kind == 1: ScrollView {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        viewport-width: self.visible-width;
        viewport-height: plist.preferred-height;
        plist := VerticalLayout {
            width: parent.visible-width;
            spacing: 2px;
            for p in State.profiles: DropRow {
                name: p.name;
                selected: p.active;
                clicked => {
                    State.use-profile(p.file);
                    root.picked();
                }
            }
        }
    }
    if root.kind == 2: VerticalLayout {
        padding: 8px;
        spacing: 6px;
        HorizontalLayout {
            padding-left: 6px;
            spacing: 8px;
            height: 28px;
            Dim {
                text: root.group.name == "" ? (State.ready ? "Нет групп для выбора" : "Ядро не запущено") : root.group.name;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if root.group.name != "": Btn {
                icon: Icons.refresh;
                text: root.group.testing ? "Проверка…" : "Задержка";
                enabled: !root.group.testing;
                clicked => {
                    State.test(root.group.name);
                }
            }
        }
        if root.group.nodes.length > 0: ScrollView {
            viewport-width: self.visible-width;
            viewport-height: list.preferred-height;
            list := VerticalLayout {
                width: parent.visible-width;
                spacing: 2px;
                for n in root.group.nodes: DropRow {
                    name: n.name;
                    selected: n.selected;
                    tail: n.delay < 0 ? "—" : n.delay == 0 ? "таймаут" : n.delay + " мс";
                    tail-color: n.delay < 0 ? Theme.faint : n.delay == 0 ? Theme.bad : n.delay < 800 ? Theme.accent-text : Theme.warn;
                    clicked => {
                        State.select(root.group.name, n.name);
                        root.picked();
                    }
                }
            }
        }
    }
}

export component HomePage inherits VerticalLayout {
    property <int> drop;
    function reveal() {
        if root.drop != 0 {
            sc.viewport-y -= max(0px, card.absolute-position.y + card.height + 4px + (root.drop == 1 ? min(State.profiles.length * 38px, 228px) + 16px : 44px + min(State.groups[0].nodes.length * 38px, 228px) + 8px) - sc.absolute-position.y - sc.visible-height);
        }
    }
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 26px;
    spacing: 8px;
    Header {
        title: "Обзор";
    }
    sc := Scroll {
        vertical-stretch: 1;
        pad: 24px;
        Column {
            max: 600px;
            VerticalLayout {
                spacing: 6px;
                padding-top: 6px;
                Text {
                    text: State.tun ? "TUN включён" : State.active ? "Системный прокси включён" : "VPN выключен";
                    color: State.active ? Theme.good : Theme.dim;
                    animate color { duration: 450ms; easing: ease-in-out; }
                    font-size: 28px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }
            HorizontalLayout {
                alignment: center;
                padding-top: 8px;
                Power { }
            }
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: State.tun ? "Отключить TUN" : "Включить TUN";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                if !State.tun && !State.admin: Text {
                    text: "Потребуется разрешение администратора";
                    color: Theme.dim;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
                if !State.running && State.status-bad: Text {
                    text: State.status;
                    color: Theme.bad;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
            }
            Rectangle {
                height: 6px;
            }
            card := Card {
                height: 64px;
                background: Theme.card;
                Rectangle {
                    x: 1px;
                    width: parent.width * 0.3;
                    height: parent.height;
                    border-radius: Theme.radius;
                    background: pa.has-hover || root.drop == 1 ? Theme.raised : Theme.raised.transparentize(1);
                    animate background { duration: Theme.fast; }
                    pa := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.drop = root.drop == 1 ? 0 : 1;
                            root.reveal();
                        }
                    }
                }
                Rectangle {
                    x: parent.width * 0.3;
                    width: parent.width * 0.7 - 1px;
                    height: parent.height;
                    border-radius: Theme.radius;
                    background: sa.has-hover || root.drop == 2 ? Theme.raised : Theme.raised.transparentize(1);
                    animate background { duration: Theme.fast; }
                    sa := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.drop = root.drop == 2 ? 0 : 2;
                            root.reveal();
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 14px;
                    Step {
                        icon: Icons.file;
                        label: "Профиль";
                        value: State.profile == "" ? "—" : State.profile;
                        horizontal-stretch: 3;
                    }
                    Link { }
                    Step {
                        icon: Icons.nodes;
                        label: State.node-group == "" ? "Группа" : State.node-group;
                        value: State.node == "" ? "—" : State.node;
                        horizontal-stretch: 3.5;
                    }
                    Link { }
                    Step {
                        icon: Icons.globe;
                        label: "Сервер";
                        value: State.node-end == "" ? "—" : State.node-end;
                        extra: State.node-delay > 0 ? State.node-delay + " мс" : "";
                        horizontal-stretch: 3.5;
                    }
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            d: root.drop != 0 ? Icons.chevdown : Icons.chevron;
                            width: 14px;
                            height: 14px;
                        }
                    }
                }
                if root.drop != 0: Drop {
                    x: root.drop == 1 ? 0px : parent.width - self.width;
                    y: parent.height + 4px;
                    kind: root.drop;
                    group: State.groups[0];
                    picked => {
                        root.drop = 0;
                    }
                }
            }
            VerticalLayout {
                spacing: 8px;
                Dim {
                    text: "Режим маршрутизации";
                }
                Card {
                    HorizontalLayout {
                        padding: 4px;
                        spacing: 4px;
                        Seg {
                            text: "Правила";
                            active: State.mode == "rule";
                            clicked => {
                                State.set-mode("rule");
                            }
                        }
                        Seg {
                            text: "Глобально";
                            active: State.mode == "global";
                            clicked => {
                                State.set-mode("global");
                            }
                        }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                spacing: 12px;
                Label {
                    text: "Системный прокси";
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Toggle {
                        on: State.sysproxy;
                        toggled(v) => {
                            State.set-sysproxy(v);
                        }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                spacing: 24px;
                padding-left: 4px;
                Stat {
                    icon: Icons.down;
                    label: "Загрузка";
                    value: State.down-speed;
                    sub: "Всего " + State.down-total;
                }
                Rectangle {
                    width: 1px;
                    background: Theme.line;
                }
                Stat {
                    icon: Icons.up;
                    label: "Отдача";
                    value: State.up-speed;
                    sub: "Всего " + State.up-total;
                }
            }
        }
    }
}
