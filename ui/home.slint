import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { State } from "types.slint";
import { Card, Header, Label, Dim, Seg, Icon, Toggle, Scroll, Column } from "parts.slint";

component Stat inherits HorizontalLayout {
    in property <string> icon;
    in property <string> label;
    in property <string> value;
    in property <string> sub;
    horizontal-stretch: 1;
    spacing: 12px;
    VerticalLayout {
        alignment: center;
        Icon {
            d: root.icon;
        }
    }
    VerticalLayout {
        spacing: 2px;
        Dim {
            text: root.label;
        }
        Text {
            text: root.value;
            color: Theme.text;
            font-size: 20px;
            font-weight: 600;
        }
        Dim {
            text: root.sub;
            color: Theme.faint;
        }
    }
}

component Step inherits HorizontalLayout {
    in property <string> icon;
    in property <string> label;
    in property <string> value;
    in property <string> extra;
    spacing: 10px;
    horizontal-stretch: 1;
    VerticalLayout {
        alignment: center;
        Icon {
            d: root.icon;
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        Dim {
            text: root.label;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.value;
                color: Theme.text;
                font-size: 14px;
                overflow: elide;
            }
            Text {
                text: root.extra;
                color: Theme.accent-text;
                font-size: 14px;
            }
        }
    }
}

component Link inherits Rectangle {
    width: 40px;
    Rectangle {
        x: 4px;
        width: 26px;
        height: 1px;
        background: Theme.line;
    }
    Rectangle {
        x: 30px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        border-width: 1px;
        border-color: Theme.faint;
    }
}

component Power inherits Rectangle {
    width: 148px;
    height: 148px;
    border-radius: 74px;
    border-width: 1px;
    border-color: State.tun ? Theme.accent-line : Theme.line;
    Rectangle {
        width: 128px;
        height: 128px;
        border-radius: 64px;
        border-width: State.tun ? 1px : 0px;
        border-color: Theme.accent-line;
        background: State.tun ? (ta.has-hover ? Theme.hover : Theme.accent-soft) : (ta.has-hover ? Theme.accent-hover : Theme.accent);
        Icon {
            d: Icons.power;
            width: 44px;
            height: 44px;
            stroke-width: 2.2px;
            color: State.tun ? Theme.accent-text : #ffffff;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            State.set-tun(!State.tun);
        }
    }
}

export component HomePage inherits VerticalLayout {
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 26px;
    spacing: 8px;
    Header {
        title: "Обзор";
    }
    Scroll {
        vertical-stretch: 1;
        pad: 24px;
        Column {
            max: 600px;
            VerticalLayout {
                spacing: 6px;
                padding-top: 6px;
                Text {
                    text: State.tun ? "TUN включён" : "TUN выключен";
                    color: Theme.text;
                    font-size: 28px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }
            HorizontalLayout {
                alignment: center;
                padding-top: 8px;
                Power { }
            }
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: State.tun ? "Отключить TUN" : "Включить TUN";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                if !State.tun && !State.admin: Text {
                    text: "Потребуется разрешение администратора";
                    color: Theme.dim;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
                if !State.running && State.status-bad: Text {
                    text: State.status;
                    color: Theme.bad;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
            }
            Rectangle {
                height: 6px;
            }
            Card {
                height: 64px;
                background: ta.has-hover ? Theme.raised : Theme.card;
                ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        State.page = 1;
                        State.page-changed(1);
                    }
                }
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 14px;
                    Step {
                        icon: Icons.file;
                        label: "Профиль";
                        value: State.profile == "" ? "—" : State.profile;
                    }
                    Link { }
                    Step {
                        icon: Icons.nodes;
                        label: State.node-group == "" ? "Группа" : State.node-group;
                        value: State.node == "" ? "—" : State.node;
                    }
                    Link { }
                    Step {
                        icon: Icons.globe;
                        label: "Сервер";
                        value: State.node-end == "" ? "—" : State.node-end;
                        extra: State.node-delay > 0 ? State.node-delay + " мс" : "";
                    }
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            d: Icons.chevron;
                            width: 14px;
                            height: 14px;
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: 8px;
                Dim {
                    text: "Режим маршрутизации";
                }
                Card {
                    HorizontalLayout {
                        padding: 4px;
                        spacing: 4px;
                        Seg {
                            text: "Правила";
                            active: State.mode == "rule";
                            clicked => {
                                State.set-mode("rule");
                            }
                        }
                        Seg {
                            text: "Глобально";
                            active: State.mode == "global";
                            clicked => {
                                State.set-mode("global");
                            }
                        }
                        Seg {
                            text: "Напрямую";
                            active: State.mode == "direct";
                            clicked => {
                                State.set-mode("direct");
                            }
                        }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                spacing: 12px;
                Label {
                    text: "Системный прокси";
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Toggle {
                        on: State.sysproxy;
                        toggled(v) => {
                            State.set-sysproxy(v);
                        }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                spacing: 24px;
                padding-left: 4px;
                Stat {
                    icon: Icons.down;
                    label: "Загрузка";
                    value: State.down-speed;
                    sub: "Всего " + State.down-total;
                }
                Rectangle {
                    width: 1px;
                    background: Theme.line;
                }
                Stat {
                    icon: Icons.up;
                    label: "Отдача";
                    value: State.up-speed;
                    sub: "Всего " + State.up-total;
                }
            }
        }
    }
}
