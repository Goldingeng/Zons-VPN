import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { State } from "types.slint";
import { Card, Header, Head, Label, Dim, Btn, Toggle, Scroll, Column, Icon } from "parts.slint";

component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    padding: 16px;
    spacing: 12px;
    VerticalLayout {
        alignment: center;
        spacing: 3px;
        horizontal-stretch: 1;
        Label {
            text: root.label;
        }
        if root.hint != "": Dim {
            text: root.hint;
        }
    }
    @children
}

export component SettingsPage inherits VerticalLayout {
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 26px;
    spacing: 18px;
    Header {
        title: "Настройки";
    }
    Scroll {
        vertical-stretch: 1;
        pad: 24px;
        Column {
            Head {
                text: "Приложение";
            }
            Card {
                VerticalLayout {
                    Row {
                        label: "Порт прокси";
                        VerticalLayout {
                            alignment: center;
                            LineEdit {
                                width: 110px;
                                text: State.port;
                                input-type: number;
                                horizontal-alignment: right;
                                accepted(t) => {
                                    State.set-port(t.to-float());
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.line;
                    }
                    Row {
                        label: "Запускать вместе с Windows";
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                on: State.autostart;
                                toggled(v) => {
                                    State.set-autostart(v);
                                }
                            }
                        }
                    }
                }
            }
            Head {
                text: "Ядро";
            }
            Card {
                Row {
                    label: State.core-version == "" ? "mihomo не найдено" : "mihomo " + State.core-version;
                    hint: State.ready ? "Работает" : State.running ? "Запускается" : "Остановлено";
                    VerticalLayout {
                        alignment: center;
                        Btn {
                            icon: Icons.refresh;
                            text: "Перезапустить";
                            clicked => {
                                State.restart();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Btn {
                            icon: Icons.down;
                            text: "Обновить";
                            clicked => {
                                State.update-core();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Btn {
                            icon: Icons.file;
                            text: "Журнал ядра";
                            clicked => {
                                State.open-log();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Btn {
                            icon: Icons.folder;
                            text: "Открыть папку";
                            clicked => {
                                State.open-dir();
                            }
                        }
                    }
                }
            }
            if State.status != "": Text {
                text: State.status;
                color: State.status-bad ? Theme.bad : Theme.dim;
                font-size: 12px;
                wrap: word-wrap;
            }
            Head {
                text: "О программе";
            }
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                d: Icons.shield;
                                width: 30px;
                                height: 30px;
                                color: Theme.accent-text;
                            }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Zons VPN";
                                color: Theme.text;
                                font-size: 20px;
                                font-weight: 600;
                            }
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.line;
                    }
                    Dim {
                        text: "Сделано на Slint · slint.dev";
                    }
                }
            }
        }
    }
}
