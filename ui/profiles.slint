import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { State, Profile } from "types.slint";
import { Card, Header, Head, Dim, Btn, Scroll, Column, Icon } from "parts.slint";

component ProfileRow inherits Rectangle {
    in property <Profile> p;
    height: 62px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.p.active ? Theme.accent-line : Theme.line;
    background: root.p.active ? Theme.accent-soft : ta.has-hover ? Theme.raised : Theme.card;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            State.use-profile(root.p.file);
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: Theme.raised;
                Icon {
                    d: Icons.file;
                    width: 16px;
                    height: 16px;
                    color: root.p.active ? Theme.accent-text : Theme.dim;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.p.name;
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            Dim {
                text: root.p.url == "" ? "Локальный файл" : root.p.url;
                overflow: elide;
            }
        }
        if root.p.active: HorizontalLayout {
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                Icon {
                    d: Icons.check;
                    width: 13px;
                    height: 13px;
                    color: Theme.accent-text;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                icon: Icons.refresh;
                text: "Обновить";
                height: 28px;
                enabled: root.p.url != "" && !State.updating;
                clicked => {
                    State.update-profiles(root.p.name);
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                text: "Удалить";
                height: 28px;
                clicked => {
                    State.remove-profile(root.p.file);
                }
            }
        }
    }
}

export component ProfilesPage inherits VerticalLayout {
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 26px;
    spacing: 18px;
    Header {
        title: "Профили";
        VerticalLayout {
            alignment: center;
            Btn {
                icon: Icons.refresh;
                text: State.updating ? "Обновление…" : "Обновить все";
                enabled: !State.updating && State.profiles.length > 0;
                clicked => {
                    State.update-profiles("");
                }
            }
        }
    }
    Scroll {
        vertical-stretch: 1;
        pad: 24px;
        Column {
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Head {
                        text: "Добавить профиль";
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            spacing: 4px;
                            width: 170px;
                            name := LineEdit {
                                placeholder-text: "Название профиля";
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            url := LineEdit {
                                placeholder-text: "Ссылка на подписку";
                            }
                        }
                        VerticalLayout {
                            alignment: end;
                            Btn {
                                icon: Icons.plus;
                                text: "Добавить";
                                primary: true;
                                clicked => {
                                    State.add-profile(name.text, url.text);
                                    name.text = "";
                                    url.text = "";
                                }
                            }
                        }
                    }
                }
            }
            if State.note != "": Text {
                text: State.note;
                color: State.note-bad ? Theme.bad : Theme.dim;
                font-size: 12px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                padding-top: 4px;
                alignment: start;
                Head {
                    text: "Ваши профили";
                }
                Dim {
                    text: State.profiles.length;
                    vertical-alignment: center;
                }
            }
            for p in State.profiles: ProfileRow {
                p: p;
            }
        }
    }
}
