import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { State, Profile } from "types.slint";
import { Card, Title, Dim, Btn, Scroll } from "parts.slint";

component ProfileRow inherits Rectangle {
    in property <Profile> p;
    height: 64px;
    border-radius: 10px;
    border-width: root.p.active ? 1px : 0px;
    border-color: Theme.accent;
    background: root.p.active ? Theme.accent-soft : ta.has-hover ? Theme.hover : Theme.card;
    ta := TouchArea {
        clicked => {
            State.use-profile(root.p.file);
        }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.p.name;
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            Dim {
                text: root.p.url == "" ? "Локальный файл" : root.p.url;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                text: "Обновить";
                enabled: root.p.url != "" && !State.updating;
                clicked => {
                    State.update-profiles(root.p.name);
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                text: "Удалить";
                clicked => {
                    State.remove-profile(root.p.file);
                }
            }
        }
    }
}

export component ProfilesPage inherits VerticalLayout {
    padding: 24px;
    spacing: 16px;
    HorizontalLayout {
        spacing: 8px;
        Title {
            text: "Профили";
            horizontal-stretch: 1;
        }
        Btn {
            text: State.updating ? "Обновление…" : "Обновить все";
            enabled: !State.updating;
            clicked => {
                State.update-profiles("");
            }
        }
    }
    Card {
        HorizontalLayout {
            padding: 12px;
            spacing: 8px;
            name := LineEdit {
                width: 170px;
                placeholder-text: "Имя";
            }
            url := LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "Ссылка на подписку";
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    text: "Добавить";
                    primary: true;
                    clicked => {
                        State.add-profile(name.text, url.text);
                        name.text = "";
                        url.text = "";
                    }
                }
            }
        }
    }
    if State.status != "": Dim {
        text: State.status;
        wrap: word-wrap;
    }
    Scroll {
        vertical-stretch: 1;
        for p in State.profiles: ProfileRow {
            p: p;
        }
    }
}
