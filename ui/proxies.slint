import { Theme } from "theme.slint";
import { State, Node, Group } from "types.slint";
import { Card, Title, Dim, Btn, Scroll } from "parts.slint";

component NodeCard inherits Rectangle {
    in property <Node> node;
    callback clicked;
    border-radius: 10px;
    border-width: root.node.selected ? 1px : 0px;
    border-color: Theme.accent;
    background: root.node.selected ? Theme.accent-soft : ta.has-hover ? Theme.hover : Theme.bg;
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        Text {
            text: root.node.name;
            color: Theme.text;
            font-size: 13px;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 6px;
            Dim {
                text: root.node.kind;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                font-size: 12px;
                text: root.node.delay < 0 ? "" : root.node.delay == 0 ? "таймаут" : "" + root.node.delay + " ms";
                color: root.node.delay == 0 ? Theme.bad : root.node.delay < 300 ? Theme.good : root.node.delay < 800 ? Theme.warn : Theme.bad;
            }
        }
    }
}

component GroupCard inherits Card {
    in property <Group> group;
    property <length> cw: 210px;
    property <length> ch: 58px;
    property <length> gap: 8px;
    property <length> inner: root.width - 32px;
    property <int> cols: Math.max(1, Math.floor((root.inner + root.gap) / (root.cw + root.gap)));
    property <length> w: (root.inner - (root.cols - 1) * root.gap) / root.cols;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: root.group.name;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 600;
                    overflow: elide;
                }
                Dim {
                    text: root.group.kind + " · " + root.group.now;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    text: root.group.testing ? "Проверка…" : "Задержка";
                    enabled: !root.group.testing;
                    clicked => {
                        State.test(root.group.name);
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    text: root.group.open ? "Свернуть" : "Развернуть";
                    clicked => {
                        State.toggle-group(root.group.name);
                    }
                }
            }
        }
        if root.group.open: Rectangle {
            height: Math.max(0, Math.ceil(root.group.nodes.length / root.cols)) * (root.ch + root.gap) - root.gap;
            for n[i] in root.group.nodes: NodeCard {
                node: n;
                x: (i - Math.floor(i / root.cols) * root.cols) * (root.w + root.gap);
                y: Math.floor(i / root.cols) * (root.ch + root.gap);
                width: root.w;
                height: root.ch;
                clicked => {
                    State.select(root.group.name, n.name);
                }
            }
        }
    }
}

export component ProxiesPage inherits VerticalLayout {
    padding: 24px;
    spacing: 16px;
    Title {
        text: "Прокси";
    }
    if State.groups.length == 0: Dim {
        text: State.ready ? "В профиле нет групп для выбора" : "Ядро не запущено";
    }
    Scroll {
        vertical-stretch: 1;
        gap: 12px;
        for g in State.groups: GroupCard {
            group: g;
        }
    }
}
