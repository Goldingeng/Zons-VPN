import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { State, Node, Group } from "types.slint";
import { Card, Header, Dim, Btn, Scroll, Column, Icon } from "parts.slint";

component NodeRow inherits Rectangle {
    in property <Node> node;
    in property <bool> last;
    callback clicked;
    height: 44px;
    border-radius: 8px;
    border-width: root.node.selected ? 1px : 0px;
    border-color: Theme.accent-line;
    background: root.node.selected ? Theme.accent-soft : ta.has-hover ? Theme.hover : transparent;
    if !root.last && !root.node.selected: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 1.5px;
                border-color: root.node.selected ? Theme.accent-text : Theme.faint;
                if root.node.selected: Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.accent-text;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Icon {
                d: root.node.kind == "Direct" || root.node.kind == "Reject" ? Icons.globe : root.node.kind == "Selector" || root.node.kind == "URLTest" || root.node.kind == "Fallback" || root.node.kind == "LoadBalance" ? Icons.nodes : Icons.shield;
                width: 16px;
                height: 16px;
                color: root.node.selected ? Theme.accent-text : Theme.dim;
            }
        }
        Text {
            text: root.node.name;
            color: Theme.text;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 3;
        }
        Text {
            text: root.node.kind;
            color: Theme.dim;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            width: 70px;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-alignment: right;
            text: root.node.delay < 0 ? "—" : root.node.delay == 0 ? "таймаут" : root.node.delay + " мс";
            color: root.node.delay < 0 ? Theme.faint : root.node.delay == 0 ? Theme.bad : root.node.delay < 800 ? Theme.accent-text : Theme.warn;
        }
    }
}

component GroupCard inherits Card {
    in property <Group> group;
    VerticalLayout {
        padding: 18px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                spacing: 3px;
                horizontal-stretch: 1;
                Text {
                    text: root.group.name;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 600;
                    overflow: elide;
                }
                Dim {
                    text: root.group.kind + " · " + root.group.now;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    icon: Icons.refresh;
                    text: root.group.testing ? "Проверка…" : "Задержка";
                    enabled: !root.group.testing;
                    clicked => {
                        State.test(root.group.name);
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    text: root.group.open ? "Свернуть" : "Развернуть";
                    clicked => {
                        State.toggle-group(root.group.name);
                    }
                }
            }
        }
        if root.group.open: VerticalLayout {
            spacing: 2px;
            for n[i] in root.group.nodes: NodeRow {
                node: n;
                last: i == root.group.nodes.length - 1;
                clicked => {
                    State.select(root.group.name, n.name);
                }
            }
        }
    }
}

export component ProxiesPage inherits VerticalLayout {
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 26px;
    spacing: 18px;
    Header {
        title: "Прокси";
    }
    if State.groups.length == 0: Dim {
        text: State.ready ? "В профиле нет групп для выбора" : "Ядро не запущено";
    }
    Scroll {
        vertical-stretch: 1;
        pad: 24px;
        Column {
            max: 860px;
            for g in State.groups: GroupCard {
                group: g;
            }
        }
    }
}
