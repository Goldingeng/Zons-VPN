import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { State } from "types.slint";
import { Card, Header, Head, Dim, Btn, Scroll, AppRow, Empty } from "parts.slint";

component ListCard inherits Card {
    in property <string> title;
    in property <int> count;
    horizontal-stretch: 1;
    VerticalLayout {
        HorizontalLayout {
            padding: 14px;
            spacing: 8px;
            alignment: start;
            Head {
                text: root.title;
            }
            Dim {
                text: root.count;
                vertical-alignment: center;
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
        VerticalLayout {
            padding: 6px;
            vertical-stretch: 1;
            @children
        }
    }
}

export component BypassPage inherits VerticalLayout {
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 26px;
    padding-bottom: 24px;
    spacing: 16px;
    Header {
        title: "Мимо VPN";
        VerticalLayout {
            alignment: center;
            Btn {
                icon: Icons.grid;
                text: "Игры Steam";
                clicked => {
                    State.open-picks(1);
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                icon: Icons.pulse;
                text: "Запущенные";
                clicked => {
                    State.open-picks(2);
                }
            }
        }
    }
    Card {
        HorizontalLayout {
            padding: 10px;
            spacing: 8px;
            app := LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "Имя приложения, например telegram.exe";
                accepted(t) => {
                    State.add-app(t);
                    self.text = "";
                }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    icon: Icons.plus;
                    text: "Добавить";
                    primary: true;
                    enabled: app.text != "";
                    clicked => {
                        State.add-app(app.text);
                        app.text = "";
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    icon: Icons.folder;
                    text: "Обзор…";
                    clicked => {
                        State.browse-app();
                    }
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 12px;
        vertical-stretch: 1;
        ListCard {
            title: "Исключения";
            count: State.bypass.length;
            if State.bypass.length == 0: Empty {
                vertical-stretch: 1;
                icon: Icons.bypass;
                title: "Исключений пока нет";
            }
            if State.bypass.length > 0: Scroll {
                vertical-stretch: 1;
                gap: 2px;
                for a in State.bypass: AppRow {
                    name: a.label;
                    hint: a.hint;
                    icon: a.icon;
                    slot: true;
                    action: "Убрать";
                    clicked => {
                        State.remove-app(a.exe);
                    }
                }
            }
        }
        ListCard {
            title: "Сейчас в сети";
            count: State.seen-apps.length;
            if State.seen-apps.length == 0: Empty {
                vertical-stretch: 1;
                icon: Icons.pulse;
                title: State.running ? "Приложения ещё не подключались" : "Ядро не запущено";
            }
            if State.seen-apps.length > 0: Scroll {
                vertical-stretch: 1;
                gap: 2px;
                for a in State.seen-apps: AppRow {
                    name: a.label;
                    hint: a.hint;
                    icon: a.icon;
                    slot: true;
                    action: "Добавить";
                    clicked => {
                        State.add-app(a.exe);
                    }
                }
            }
        }
    }
}

export component PickPanel inherits Rectangle {
    property <float> t;
    background: #000000a0;
    opacity: root.t;
    animate t { duration: 220ms; easing: ease-out; }
    init => {
        root.t = 1;
    }
    TouchArea {
        clicked => {
            State.pick-kind = 0;
        }
    }
    Card {
        width: min(560px, root.width - 64px);
        height: root.height - 80px;
        y: 40px + (1 - root.t) * 24px;
        TouchArea { }
        VerticalLayout {
            HorizontalLayout {
                padding: 14px;
                spacing: 8px;
                Head {
                    text: State.pick-kind == 1 ? "Игры Steam" : "Запущенные программы";
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Btn {
                    icon: Icons.close;
                    text: "Закрыть";
                    clicked => {
                        State.pick-kind = 0;
                    }
                }
            }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-bottom: 10px;
                LineEdit {
                    placeholder-text: "Поиск";
                    edited(t) => {
                        State.find-picks(t);
                    }
                    init => {
                        self.focus();
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            VerticalLayout {
                padding: 6px;
                vertical-stretch: 1;
                if State.picks.length == 0: Empty {
                    vertical-stretch: 1;
                    icon: State.pick-kind == 1 ? Icons.grid : Icons.pulse;
                    title: State.pick-busy ? "Ищу…" : State.pick-kind == 1 ? "Steam не найден или все игры уже в исключениях" : "Нет подходящих программ";
                }
                if State.picks.length > 0: Scroll {
                    vertical-stretch: 1;
                    gap: 2px;
                    for p in State.picks: AppRow {
                        name: p.label;
                        hint: p.hint;
                        icon: p.icon;
                        slot: true;
                        action: "Добавить";
                        clicked => {
                            State.add-app(p.exe);
                        }
                    }
                }
            }
        }
    }
}
