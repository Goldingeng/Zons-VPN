import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { State } from "types.slint";
import { Card, Header, Head, Dim, Btn, Scroll, AppRow, Empty, Hint } from "parts.slint";

component ListCard inherits Card {
    in property <string> title;
    in property <int> count;
    horizontal-stretch: 1;
    VerticalLayout {
        HorizontalLayout {
            padding: 14px;
            spacing: 8px;
            alignment: start;
            Head {
                text: root.title;
            }
            Dim {
                text: root.count;
                vertical-alignment: center;
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
        VerticalLayout {
            padding: 6px;
            vertical-stretch: 1;
            @children
        }
    }
}

export component BypassPage inherits VerticalLayout {
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 26px;
    padding-bottom: 24px;
    spacing: 16px;
    Header {
        title: "Мимо VPN";
    }
    Dim {
        text: "Трафик этих приложений идёт напрямую, минуя прокси и TUN";
        font-size: 13px;
        wrap: word-wrap;
    }
    Card {
        HorizontalLayout {
            padding: 10px;
            spacing: 8px;
            app := LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "Имя приложения, например telegram.exe";
                accepted(t) => {
                    State.add-app(t);
                    self.text = "";
                }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    icon: Icons.plus;
                    text: "Добавить";
                    primary: true;
                    clicked => {
                        State.add-app(app.text);
                        app.text = "";
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    icon: Icons.folder;
                    text: "Обзор…";
                    clicked => {
                        State.browse-app();
                    }
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 12px;
        vertical-stretch: 1;
        ListCard {
            title: "Исключения";
            count: State.bypass.length;
            if State.bypass.length == 0: Empty {
                vertical-stretch: 1;
                icon: Icons.bypass;
                title: "Исключений пока нет";
                text: "Укажите имя .exe или выберите приложение через «Обзор…»";
            }
            if State.bypass.length > 0: Scroll {
                vertical-stretch: 1;
                gap: 2px;
                for a in State.bypass: AppRow {
                    name: a;
                    action: "Убрать";
                    clicked => {
                        State.remove-app(a);
                    }
                }
            }
        }
        ListCard {
            title: "Сейчас в сети";
            count: State.seen-apps.length;
            if State.seen-apps.length == 0: Empty {
                vertical-stretch: 1;
                icon: Icons.pulse;
                title: State.running ? "Приложения ещё не подключались" : "Ядро не запущено";
                text: State.running ? "Здесь появятся приложения, которые используют соединение" : "Список появится после запуска ядра";
            }
            if State.seen-apps.length > 0: Scroll {
                vertical-stretch: 1;
                gap: 2px;
                for a in State.seen-apps: AppRow {
                    name: a;
                    action: "Добавить";
                    clicked => {
                        State.add-app(a);
                    }
                }
            }
        }
    }
    Hint {
        text: "Приложения из списка справа можно добавить в исключения";
    }
}
